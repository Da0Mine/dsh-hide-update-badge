{
  "name": "dsh-hide-update-badge",
  "version": "1.0.1",
  "description": "Hide the built-in DSH Desktop update badge (the “新版本” pill beside the account button). Pure CSS + label-based hiding; update checking itself keeps working. | 隐藏 DSH 桌面版自带的「新版本」更新角标，不改变更新检查行为。",
  "license": "MIT",
  "author": "江浩文 (Da0Mine)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "update-badge",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Da0Mine/dsh-hide-update-badge.git"
  },
  "homepage": "https://github.com/Da0Mine/dsh-hide-update-badge#readme",
  "bugs": {
    "url": "https://github.com/Da0Mine/dsh-hide-update-badge/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
